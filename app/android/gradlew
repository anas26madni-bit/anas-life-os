#!/bin/sh
set -eu

app_home=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
classpath="$app_home/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$classpath" ]; then
  echo "Missing gradle-wrapper.jar. Run the approved wrapper bootstrap." >&2
  exit 1
fi

if [ -n "${JAVA_HOME:-}" ]; then
  java_command="$JAVA_HOME/bin/java"
else
  java_command=java
fi

exec "$java_command" \
  -Dorg.gradle.appname=gradlew \
  -classpath "$classpath" \
  org.gradle.wrapper.GradleWrapperMain "$@"
